# SiteGround Deployment Configuration / SiteGround Dağıtım Yapılandırması
# Copy to deploy/siteground.env and fill in. / siteground.env olarak kopyalayıp doldurun.
#
#   cp deploy/siteground.env.example deploy/siteground.env
#
# siteground.env is git-ignored so your details stay local.

# --- SSH connection (from SiteGround Site Tools → Devs → SSH) ---------------
# SSH host / SSH adresi (e.g. giom123.siteground.biz or your domain)
SG_HOST=alanadiniz.com
# SSH username / SSH kullanıcı adı (Site Tools'tan)
SG_USER=u123-abcdefgh
# SiteGround SSH port is 18765 by default / SiteGround SSH portu varsayılan 18765
SG_PORT=18765
# Private key authorized in Site Tools / Site Tools'a eklenmiş özel anahtar
SG_KEY=~/.ssh/siteground

# --- Remote web root / Uzak web kökü ---------------------------------------
# Document root for your site. Confirm with: ls ~/www on the server.
# Sitenizin doküman kökü. Sunucuda `ls ~/www` ile doğrulayın.
SG_REMOTE_DIR=~/www/alanadiniz.com/public_html
