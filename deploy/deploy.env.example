# SSH Deployment Configuration / SSH Dağıtım Yapılandırması
# Copy this file to deploy.env and fill in your server details.
# Bu dosyayı deploy.env olarak kopyalayıp sunucu bilgilerinizle doldurun.
#
#   cp deploy/deploy.env.example deploy/deploy.env
#
# deploy.env is git-ignored so your secrets stay local.

# --- SSH connection / SSH bağlantısı ---
# Remote server hostname or IP / Uzak sunucu adı veya IP
SSH_HOST=example.com
# SSH user / SSH kullanıcısı
SSH_USER=deploy
# SSH port (default 22) / SSH portu (varsayılan 22)
SSH_PORT=22
# Path to the private key used for the connection / Bağlantı için özel anahtar yolu
SSH_KEY=~/.ssh/id_ed25519

# --- Remote paths / Uzak yollar ---
# Directory on the server where the repo lives / Sunucuda reponun bulunacağı dizin
REMOTE_DIR=/opt/trefoil-torus-complex
# Git repository URL to clone on first setup / İlk kurulumda klonlanacak repo URL'i
REPO_URL=https://github.com/tansuozcelebi/Trefoil-Torus-Complex-designer.git
# Branch to deploy / Dağıtılacak dal
DEPLOY_BRANCH=main

# --- Application / Uygulama ---
# Host port the app is published on / Uygulamanın yayınlanacağı host portu
HOST_PORT=8080
